# Input directory containing _chat.txt and exported image files
WHATSAPP_INPUT_DIR=/absolute/path/to/whatsapp-export

# First product identifier to use while generating product rows
WHATSAPP_PRODUCT_START_ID=1000

# Optional overrides
WHATSAPP_CHAT_FILE=_chat.txt
WHATSAPP_OUTPUT_CSV=products.csv
WHATSAPP_LOG_FILE=log/whatsapp_products.log

