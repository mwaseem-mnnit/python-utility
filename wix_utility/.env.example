# Wix Utility
WIX_UTIL_DEFAULT_JOB=healthcheck
WIX_UTIL_LOG_DIR=log
WIX_FLOW=catalog-sync

# Wix API
WIX_BASE_URL=https://www.wixapis.com
WIX_API_KEY=
WIX_COOKIE=
WIX_SITE_ID=
WIX_ACCOUNT_ID=
WIX_DRY_RUN=true
WIX_REQUEST_TIMEOUT_SECONDS=30
WIX_MAX_RETRIES=2
WIX_RETRY_BACKOFF_SECONDS=1.5

# Local catalog inputs generated by the other utilities
WIX_INPUT_CSV=
WIX_CSV_OUTPUT_JSON=
WIX_CSV_DELIMITER=,
WIX_IMAGE_DIR=
WIX_OUTPUT_DIR=

# Duplicate prevention
WIX_MATCH_THRESHOLD=0.86

# Collection creation from CSV
WIX_COLLECTION_TITLE_COLUMN=
WIX_COLLECTION_PAGE_SIZE=100
WIX_COLLECTION_QUERY_VISIBLE_ONLY=true
WIX_COLLECTION_CREATE_ENABLED=false
WIX_COLLECTION_VISIBLE=false
